  "keyFeatures": [
    "AI-generated personalized 4-week learning plans (6 priority-ranked cards per coder)",
    "Soft skills assessment integrated into adaptive curriculum generation",
    "Team Leader analytics dashboard with real-time risk detection",
    "AI chat trainer (Groq LLM + LangChain) for on-demand learning support",
    "Moodle progress integration to track academic performance",
    "Automated risk flags for at-risk students (low scores or autonomy)",
    "GitHub and Google OAuth social login",
    "Real-time notifications via Supabase Realtime",
    "Exercise generation and submission with AI evaluation",
    "Resource search via semantic embeddings (all-MiniLM-L6-v2)"
  ],
